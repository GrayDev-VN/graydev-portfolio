RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=graynguyen.dev@gmail.com
CONTACT_FROM_EMAIL=Gray Nguyen <portfolio@your-verified-domain.com>
# Canonical production origin, for example https://your-domain.com (no path).
SITE_URL=

# Jobs storage: snapshot for local preview; postgres for scheduled collection.
JOBS_STORAGE=snapshot
# Server-only write connection, used by migration/collector. Never NEXT_PUBLIC_.
JOBS_DATABASE_URL=
# Optional read-only connection for the web app (recommended in production).
JOBS_READ_DATABASE_URL=
# Local Docker PostgreSQL only: choose your own password, do not commit it.
JOBS_POSTGRES_PASSWORD=

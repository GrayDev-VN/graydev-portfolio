{
  "name": "graydev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.jobs.local node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.jobs.local node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "npm run test:blog && npm run test:jobs && npm run test:jobs:db && npm run test:jobs:collection && npm run test:jobs:jsonld && npm run test:jobs:pipeline && npm run test:jobs:employer-api",
    "test:jobs:employer-api": "node --experimental-strip-types --test scripts/jobs.employer-api.test.ts",
    "test:jobs:live": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.jobs.local --experimental-strip-types --test scripts/jobs.live.test.ts",
    "test:jobs": "node --experimental-strip-types --test scripts/jobs.test.ts",
    "test:jobs:db": "node --experimental-strip-types --test scripts/jobs.database.test.ts",
    "test:jobs:collection": "node --experimental-strip-types --test scripts/jobs.collection.test.ts",
    "test:jobs:jsonld": "node --experimental-strip-types --test scripts/jobs.jsonld.test.ts",
    "test:jobs:pipeline": "node --experimental-strip-types --test scripts/jobs.pipeline.test.ts",
    "test:jobs:postgres": "node --env-file-if-exists=.env.jobs.local --experimental-strip-types --test scripts/jobs.postgres.test.ts",
    "jobs:db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.jobs.local --experimental-strip-types scripts/migrate-jobs.ts",
    "jobs:collect": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.jobs.local --experimental-strip-types scripts/collect-jobs.ts",
    "jobs:status": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.jobs.local --experimental-strip-types scripts/jobs-status.ts",
    "jobs:local:setup": "node --experimental-strip-types scripts/setup-jobs-local.ts",
    "jobs:local:activate": "node --experimental-strip-types scripts/activate-jobs-local.ts",
    "jobs:local:up": "docker compose --env-file .env.jobs.local -f compose.jobs.yml up -d --wait",
    "jobs:dev": "node --env-file-if-exists=.env.jobs.local node_modules/next/dist/bin/next dev",
    "test:smoke": "node --experimental-strip-types --test scripts/jobs.smoke.test.ts",
    "jobs:import": "node --experimental-strip-types scripts/import-jobs.ts",
    "test:blog": "node --experimental-strip-types --test scripts/blog.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "robots-parser": "^3.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
